{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>meziantou/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "ZOPFLI_VERSION: \"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "google/zopfli",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^zopfli-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
