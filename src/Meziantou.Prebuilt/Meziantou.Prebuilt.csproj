<Project Sdk="Meziantou.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeSharedHttpClient>true</IncludeSharedHttpClient>
    <Description>Lists the prebuilt tools (ffmpeg, ffprobe, zopfli, oxipng, pngout, cwebp, avifenc, cjxl, hb-shape, woff2_compress, opj_compress, ojph_compress, iso-jpeg, x265, heif-enc, dec265, ...) published by meziantou/prebuilt, with their version and SHA-256 checksum, and downloads them to a local cache. The package version is the release version.</Description>
    <PackageTags>prebuilt;binaries;ffmpeg;ffprobe;zopfli;oxipng;pngout;webp;cwebp;avif;avifenc;avifdec;jpegxl;jxl;cjxl;djxl;jxlinfo;jxl-oxide;font;harfbuzz;hb-shape;hb-info;hb-subset;hb-vector;hb-raster;woff2;woff2_compress;woff2_decompress;jpeg2000;jp2;j2k;openjpeg;opj_compress;opj_decompress;opj_dump;htj2k;openjph;ojph_compress;ojph_expand;jpeg;libjpeg;iso-jpeg;hevc;h265;x265;kvazaar;heic;heif;heif-enc;heif-dec;heif-info;libde265;dec265;hm;TAppEncoder;TAppDecoder</PackageTags>
    <PackageProjectUrl>https://github.com/meziantou/prebuilt</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.Prebuilt.Tests" />
  </ItemGroup>

  <!--
    The manifest lists the files of the GitHub release (version, size, SHA-256).
    It is generated by scripts/New-PrebuiltManifest.ps1 in CI, once the binaries
    are built, and passed with -p:PrebuiltManifestPath=<path>.
  -->
  <ItemGroup Condition="'$(PrebuiltManifestPath)' != ''">
    <EmbeddedResource Include="$(PrebuiltManifestPath)" LogicalName="Meziantou.Prebuilt.prebuilt-tools.json" />
  </ItemGroup>

  <Target Name="ValidatePrebuiltManifestPath" BeforeTargets="PrepareForBuild" Condition="'$(PrebuiltManifestPath)' != ''">
    <Error Condition="!Exists('$(PrebuiltManifestPath)')" Text="The prebuilt manifest '$(PrebuiltManifestPath)' does not exist." />
  </Target>

  <Target Name="EnsurePrebuiltManifestBeforePack" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(PrebuiltManifestPath)' == ''" Text="Packing requires the release manifest. Generate it with scripts/New-PrebuiltManifest.ps1 and pass -p:PrebuiltManifestPath=&lt;path&gt;." />
  </Target>

</Project>
